# Skopiuj do .env i uzupełnij.

# Klucz użytkownika GUS BIR. Testowy publiczny klucz:
GUS_API_KEY=abcde12345abcde12345

# false = środowisko testowe, true = produkcja
GUS_PRODUCTION=false

# Obsługiwane przez RegonAPI: bir1 albo bir1.1 (bir1.2 nie istnieje w bibliotece)
GUS_BIR_VERSION=bir1.1

# Timeouty (sekundy)
GUS_TIMEOUT=15
GUS_OPERATION_TIMEOUT=15

# Opcjonalnie: jeśli ustawisz, proxy będzie wymagać nagłówka X-API-Key
GUS_PROXY_API_KEY=
